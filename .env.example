# Copy to .env for local authoring. .env is git-ignored; never commit it.
# Only the local studio (npm run dev → server.ts) reads these. The public site
# on GitHub Pages is static and needs none of them.

# Port for the local studio. Default 3000.
PORT=3000

# Token every mutating /api request must carry (x-studio-token header).
# Leave empty and the server makes a fresh random one on each boot and hands it
# to the admin automatically. Set a fixed value only if you call the API from
# scripts or curl.
STUDIO_TOKEN=
